<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-MailSink-9b976ca7-5bc0-4b9b-af80-d3c76021f320</UserSecretsId>
    <!-- packages.lock.json pins the whole transitive graph, not just the versions named
         below. CI restores in locked mode, so a transitive package that moves underneath
         us fails the restore instead of quietly shipping. Regenerate with a plain
         "dotnet restore" and commit the result whenever a PackageReference changes. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project asserts a couple of internal helpers directly. -->
    <InternalsVisibleTo Include="MailSink.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <!-- A Key Vault certificate's private key is served as the secret of the same name, so the
         TLS certificate is fetched with SecretClient rather than CertificateClient. -->
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.11.1" />
    <!-- Captured mail goes to a blob container in a deployed sink, reached with the host's
         managed identity so no storage account key exists to be handed around. -->
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.2" />
    <PackageReference Include="KeyVaultReferenceResolver" Version="2.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <PackageReference Include="MimeKit" Version="4.18.1" />
    <PackageReference Include="SmtpServer" Version="11.1.0" />
  </ItemGroup>
</Project>
