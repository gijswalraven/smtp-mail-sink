{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "MailSink": {
    "MailDirectory": "mail",
    "ServerName": "mail-sink",
    "ListenAddress": "0.0.0.0",
    "MaxMessageSize": 26214400,
    "Username": "",
    "Password": "",
    "MaxConcurrentSessions": 64,
    "MaxSessionsPerClient": 8,
    "MaxAuthenticationAttempts": 3,
    "SessionTimeout": "00:02:00",
    "CommandWaitTimeout": "00:01:00",
    "HealthPort": 8080,
    "GroupByDate": true,
    "Retention": {
      "//": "MaxAge 0 keeps captured mail forever; 7.00:00:00 deletes .eml files older than a week.",
      "MaxAge": "00:00:00",
      "SweepInterval": "01:00:00"
    },
    "Tls": {
      "//": "Required outside Development. https://<vault>.vault.azure.net/certificates/<name>",
      "KeyVaultCertificateUri": "",
      "MinimumProtocol": "Tls12",
      "RefreshInterval": "01:00:00"
    }
  }
}
