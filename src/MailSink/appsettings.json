{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "MailSink": {
    "MailDirectory": "mail",
    "ServerName": "mail-sink",
    "ListenAddress": "0.0.0.0",
    "Ports": [ 1025 ],
    "MaxMessageSize": 26214400,
    "AllowAnyCredentials": true,
    "Username": "",
