<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Pinned to nuget.org only. Without <clear />, restore also picks up whatever feeds happen to be
    configured on the machine, which makes a clean clone build differently from the author's box
    and can silently resolve a package from somewhere unexpected. Every dependency here is public.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
